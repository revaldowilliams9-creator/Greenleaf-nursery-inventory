(function() {    let stateStartTime = Date.now();    let currentSessionNum = 1;    // 1. Create a stable, non-flickering live dashboard on the screen    const liveWidget = document.createElement('div');    liveWidget.style = "position:fixed; bottom:20px; right:20px; padding:15px; background:rgba(20,20,20,0.95); color:#fff; font-family:monospace; font-size:14px; z-index:999999; border-radius:8px; box-shadow:0 4px 15px rgba(0,0,0,0.5); pointer-events:none; border:1px solid #444; line-height:1.5;";    document.body.appendChild(liveWidget);    console.log("?? Tracker Active! Watch the smooth live timer on the page corner. Logs will record below without jumping:");    console.log("--------------------------------------------------------------------------------");    // 2. Continuous Loop to smoothly update the visual timer on-screen    setInterval(() => {        const isFocused = document.hasFocus();        const visibility = document.visibilityState;        const elapsedSeconds = ((Date.now() - stateStartTime) / 1000).toFixed(1);        liveWidget.innerHTML = isFocused             ? `?? <span style="color:#2ecc71; font-weight:bold;">ACTIVELY FOCUSED</span><br>?? Timer: <span style="font-size:16px; font-weight:bold;">${elapsedSeconds}s</span><br>?? Focus: ${isFocused} | Visibility: ${visibility}`            : `?? <span style="color:#e74c3c; font-weight:bold;">AWAY FROM PAGE</span><br>?? Timer: <span style="font-size:16px; font-weight:bold;">${elapsedSeconds}s</span><br>?? Focus: ${isFocused} | Visibility: ${visibility}`;    }, 100);    // 3. Record data to console when clicking AWAY    window.addEventListener('blur', function() {        const elapsedSeconds = ((Date.now() - stateStartTime) / 1000).toFixed(2);                console.log(            `?? [Session #${currentSessionNum}] FOCUSED DURATION: ${elapsedSeconds}s\n` +            `?? State Changed: User clicked AWAY. (Focus: false, Visibility: ${document.visibilityState})\n` +            `--------------------------------------------------------------------------------`        );                stateStartTime = Date.now();        currentSessionNum++;    }, true);    // 4. Record data to console when RETURNING    window.addEventListener('focus', function() {        const elapsedSeconds = ((Date.now() - stateStartTime) / 1000).toFixed(2);                console.log(            `?? [Session #${currentSessionNum}] AWAY DURATION: ${elapsedSeconds}s\n` +            `?? State Changed: User RETURNED. (Focus: true, Visibility: ${document.visibilityState})\n` +            `--------------------------------------------------------------------------------`        );                stateStartTime = Date.now();        currentSessionNum++;    }, true);})();